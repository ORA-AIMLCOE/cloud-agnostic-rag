# Private runtime configuration. Do not commit this file.
CLOUD_PROVIDER='oci'
OCI_REGION='<region>'
OCI_COMPARTMENT_ID='<compartment-ocid>'
OCI_NAMESPACE='<namespace>'
OCI_BUCKET='<bucket>'
OBJECT_STORAGE_PREFIX='documents/'
OCI_LLM_MODEL_ID='<model-or-endpoint-id>'
OCI_LLM_ENDPOINT='<oci-service-endpoint>'
OCI_LLM_FORMAT='generic'
OCI_LLM_SERVING_MODE='on_demand'
OCI_EMBEDDING_MODEL_ID='<embedding-model-or-endpoint-id>'
OCI_EMBEDDING_ENDPOINT='<oci-native-inference-endpoint>'
OCI_EMBEDDING_SERVING_MODE='on_demand'
OCI_EMBEDDING_DIMENSIONS='1024'
OCI_EMBEDDING_SET_DIMENSIONS='false'
OCI_CHUNK_CHARS='1800'
OCI_CHUNK_OVERLAP='200'
OCI_DB_USER='<application-user>'
OCI_DB_PASSWORD='<database-password>'
OCI_DB_DSN='tcps://<host>:1521/<service-name>'
OCI_DB_WALLET_DIR=''
OCI_DB_WALLET_PASSWORD=''
OCI_CONFIG_FILE='~/.oci/config'
OCI_PROFILE='DEFAULT'
DISTRIBUTOR_MODE='true'
