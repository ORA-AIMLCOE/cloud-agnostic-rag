# Include inside the existing authenticated HTTPS server block.
# TLS and Basic authentication are inherited from that server.
location = /aws-rag {
    return 301 /aws-rag/;
}
# Machine clients authenticate with the application's Bearer key.
# Browser routes below continue to inherit the shared workspace login.
location = /aws-rag/api/v1/answers {
    auth_basic off;
    client_max_body_size 16k;
    proxy_pass http://127.0.0.1:8012/api/v1/answers;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Authorization $http_authorization;
    proxy_read_timeout 300s;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options nosniff always;
}
location ^~ /aws-rag/api/ {
    client_max_body_size 11m;
    proxy_pass http://127.0.0.1:8012/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Authorization "";
    proxy_read_timeout 420s;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options nosniff always;
}
location ^~ /aws-rag/ {
    root /var/www;
    try_files $uri $uri/ /aws-rag/index.html;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
}
