# Dedicated site: /etc/nginx/sites-available/cloudshift
# Load from the dedicated cloudshift-nginx.conf only after the certificate and password file exist.
# Other server blocks (including the colleague's port 8080) are unchanged.
server {
    listen 80;
    server_name 150.230.130.251;
    access_log off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/cloudshift-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 404; }
}

server {
    listen 8081 ssl;
    server_name 150.230.130.251;
    ssl_certificate /etc/letsencrypt/live/cloudshift-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cloudshift-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 256k;
    auth_basic "Cloudshift";
    auth_basic_user_file /etc/nginx/cloudshift.htpasswd;
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:8011;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization "";
        proxy_read_timeout 300s;
    }
}
