APP_NAME=
CLOUD_PROVIDER=
# Verified Sydney resources. This personalized file contains a real database password.
AWS_REGION=
AWS_PROFILE=
AWS_BEDROCK_MODEL_ID=
AWS_S3_BUCKET=
AWS_S3_PREFIX=
AWS_KNOWLEDGE_BASE_ID=
AWS_KB_DATA_SOURCE_ID=
AWS_KB_MODE=
# AWS_PROFILE is read by the app. Refresh aws-rag-provision with aws login when expired.
# Start scripts/start-db-tunnel.ps1 before starting the backend.
# Deployed application: use an IAM role. Never put access keys in this file.
DATABASE_URL=
LOG_LEVEL=INFO
# Local logs go to stdout. CloudWatch shipping requires a separately configured deployment.
MAX_UPLOAD_BYTES=
TOP_K=
CONTEXT_MAX_CHARS=
LLM_MAX_TOKENS=
LLM_TEMPERATURE=
INGESTION_TIMEOUT_SECONDS=
CORS_ORIGINS=
# Keep tracing off: external tracing could capture prompts and document text.
LANGSMITH_TRACING=
