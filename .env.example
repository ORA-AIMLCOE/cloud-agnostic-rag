# Converter configuration only. Target OCI RAG settings are entered in the UI.
CONVERTER_HOST=127.0.0.1
CONVERTER_PORT=8011
# Native OCI service endpoint, e.g. https://inference.generativeai.<region>.oci.oraclecloud.com
# Do not append /openai/v1 or /actions/chat.
ASTRA_BASE_URL=
ASTRA_MODEL_ID=
ASTRA_COMPARTMENT_ID=
ASTRA_API_FORMAT=oci_generic
ASTRA_AUTH_MODE=oci_profile
# This profile contains tenancy, user, fingerprint, key_file and region.
ASTRA_OCI_CONFIG_FILE=~/.oci/config
ASTRA_OCI_PROFILE=DEFAULT
ASTRA_VERBOSITY=MEDIUM
# Code patches need more output space than short chat answers.
ASTRA_MAX_OUTPUT_TOKENS=24000
ASTRA_MAX_ATTEMPTS=2
# Only used in optional compatible responses/chat_completions API-key mode.
ASTRA_API_KEY=
VALIDATOR_IMAGE=aws-oci-validator:oracle-v1
JOB_RETENTION_HOURS=24

# Optional exact HTTPS origin; requires an authenticated reverse proxy.
# Keep the backend listening on 127.0.0.1.
CLOUDSHIFT_PUBLIC_ORIGIN=
